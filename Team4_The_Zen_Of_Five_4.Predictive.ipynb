    "numeric_features = [\n",
    "    \"weight\", \"height\", \"bmi\", \"cci_score\",\n",
    "    \"eye_opening\", \"verbal_response\", \"movement\", \"gcs\",\n",
    "    \"pulse\", \"respiration\", \"systolic_blood_pressure\", \"diastolic_blood_pressure\",\n",
    "    \"map_value\", \"body_temperature\", \"visit_times\",\n",
    "    \"nyha_cardiac_function_classification\", \"killip_grade\",\n",
    "]\n",
    "categorical_features = [\n",
    "    \"gender\", \"agecat\", \"occupation\", \"bmi_category\", \"consciousness\",\n",
    "    \"admission_ward\", \"admission_way\", \"type_of_heart_failure\",\n",
    "]\n",
    "comorbidity_flags = [\n",
    "    \"cerebrovascular_disease\", \"dementia\", \"chronic_obstructive_pulmonary_disease\",\n",
    "    \"connective_tissue_disease\", \"peptic_ulcer_disease\", \"diabetes\",\n",
    "    \"moderate_to_severe_chronic_kidney_disease\", \"hemiplegia\", \"leukemia\",\n",
    "    \"malignant_lymphoma\", \"solid_tumor\", \"liver_disease\", \"aids\",\n",
    "    \"myocardial_infarction\", \"congestive_heart_failure\", \"peripheral_vascular_disease\",\n",
    "]\n",
    "numeric_all = numeric_features + comorbidity_flags\n",
    "\n",
    "for c in comorbidity_flags:\n",
    "    df[c] = pd.to_numeric(df[c], errors=\"coerce\")\n",
    "\n",
    "X = df[numeric_all + categorical_features].copy()\n",
    "y = df[\"target\"]\n",
    "\n",
    "# =====================================================================\n",
    "# 4. NULL HYPOTHESIS TESTING (per parameter)\n",
    "#    H0: the parameter is not associated with discharge destination.\n",
    "# =====================================================================\n",
    "results = []\n",
    "for col in numeric_all:\n",
    "    valid = X[col].notna()\n",
    "    if valid.sum() < 10 or X.loc[valid, col].nunique() < 2:\n",
    "        continue\n",
    "    r, p = stats.pointbiserialr(y[valid], X.loc[valid, col])\n",
    "    results.append({\"parameter\": col, \"test\": \"point-biserial r\", \"statistic\": r, \"p_value\": p})\n",
    "\n",
    "for col in categorical_features:\n",
    "    tab = pd.crosstab(X[col].fillna(\"Missing\"), y)\n",
    "    if tab.shape[0] < 2:\n",
    "        continue\n",
    "    chi2, p, dof, _ = stats.chi2_contingency(tab)\n",
    "    results.append({\"parameter\": col, \"test\": \"chi-square\", \"statistic\": chi2, \"p_value\": p})\n",
    "\n",
    "results_df = pd.DataFrame(results).sort_values(\"p_value\")\n",
    "results_df[\"reject_H0_at_0.05\"] = results_df[\"p_value\"] < 0.05\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"NULL HYPOTHESIS TESTS\")\n",
    "print(\"=\" * 70)\n",
    "print(results_df.to_string(index=False))\n",
    "n_sig = results_df[\"reject_H0_at_0.05\"].sum()\n",
    "print(f\"\\n{n_sig} of {len(results_df)} parameters reject H0 at alpha=0.05\")\n",
    "\n",
    "# ---- Graph 2: -log10(p-value) bar chart, significance threshold line ----\n",
    "plot_df = results_df.sort_values(\"p_value\").head(15).iloc[::-1]\n",
    "fig, ax = plt.subplots(figsize=(7, 6))\n",
    "colors = [\"#55A868\" if sig else \"#C44E52\" for sig in plot_df[\"reject_H0_at_0.05\"]]\n",
    "ax.barh(plot_df[\"parameter\"], -np.log10(plot_df[\"p_value\"]), color=colors)\n",
    "ax.axvline(-np.log10(0.05), color=\"black\", linestyle=\"--\", label=\"p = 0.05 threshold\")\n",
    "ax.set_xlabel(\"-log10(p-value)\")\n",
    "ax.set_title(\"Top 15 Parameters — Significance vs. Discharge Destination\")\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"q12_hypothesis_significance.png\", dpi=150)\n",
    "plt.show()\n"
   ]
  },
